---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Redirecionando para o WhatsApp · Studio Odonto"
  description="Iniciando conversa no WhatsApp oficial do Studio Odonto..."
>
  <div class="redirect-container">
    <div class="redirect-card fade-in">
      <div class="spinner"></div>
      <h1 class="redirect-title">Conectando ao WhatsApp...</h1>
      <p class="redirect-subtitle">Você será redirecionado em instantes.</p>
      <a id="direct-link" href="https://wa.me/5562992672199" class="manual-btn">
        Clique aqui se não for redirecionado automaticamente
      </a>
    </div>
  </div>

  <script>
    import { dispatchMetaDualEvent } from '../lib/analytics.js';

    (function() {
      const params = new URLSearchParams(window.location.search);
      const defaultText = "Olá, vi o anúncio e quero agendar minha avaliação com condição especial!";
      const customText = params.get('text') || defaultText;

      const phone = "5562992672199";
      const targetUrl = new URL(`https://wa.me/${phone}`);
      targetUrl.searchParams.set('text', customText);

      // Preservar UTMs na URL final do WhatsApp
      const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id'];
      utmKeys.forEach(key => {
        const val = params.get(key);
        if (val) {
          targetUrl.searchParams.set(key, val);
        }
      });

      const finalHref = targetUrl.toString();

      // Atualizar o link manual de fallback
      const manualBtn = document.getElementById('direct-link') as HTMLAnchorElement;
      if (manualBtn) {
        manualBtn.href = finalHref;
      }

      // Disparar evento de conversão Contact no Meta Pixel + C-API
      dispatchMetaDualEvent('Contact', {
        content_name: 'WhatsApp Redirect (/wa)',
        destination_url: finalHref,
      });

      // Redirecionamento rápido
      setTimeout(function() {
        window.location.href = finalHref;
      }, 120);
    })();
  </script>

  <style>
    .redirect-container {
      min-height: 75vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-3);
    }
    .redirect-card {
      background: var(--color-glass-surface);
      border: 1px solid var(--color-glass-border);
      border-radius: var(--radius-card);
      padding: var(--space-6) var(--space-4);
      text-align: center;
      max-width: 440px;
      width: 100%;
      box-shadow: var(--shadow-glow);
      backdrop-filter: blur(16px);
    }
    .spinner {
      width: 44px;
      height: 44px;
      border: 3px solid rgba(219, 158, 22, 0.2);
      border-top-color: var(--color-indigo);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto var(--space-3);
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .redirect-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: var(--space-1);
    }
    .redirect-subtitle {
      font-size: 0.9rem;
      color: #555;
      margin-bottom: var(--space-4);
    }
    .manual-btn {
      display: inline-block;
      padding: var(--space-2) var(--space-3);
      background: var(--color-navy);
      border: 1px solid var(--color-glass-border);
      border-radius: var(--radius-btn);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--color-white);
      transition: all var(--ease-fast);
    }
    .manual-btn:hover {
      background: var(--color-indigo);
      color: #fff;
    }
  </style>
</BaseLayout>
